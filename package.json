{
  "name": "embed-dash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --filter @embed-dash/shared build && pnpm --parallel --filter @embed-dash/server --filter @embed-dash/web dev",
    "test": "pnpm --filter @embed-dash/shared build && vitest run",
    "test:coverage": "pnpm --filter @embed-dash/shared build && vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "e2e": "playwright test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "8.0.0",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "@axe-core/playwright": "4.14.1",
    "@testing-library/user-event": "14.6.13"
  }
}
