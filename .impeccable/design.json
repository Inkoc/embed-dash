  "narrative": {
    "northStar": "The Index Desk",
    "overview": "embed-dash is a library card catalogue run from the keyboard. The composer is one index sheet on a desk, with the live Discord preview beside it; sending is filing channels, read by their call numbers, into a deep-ink tray that holds the selection and each result. Measurements are the only things set in monospace.",
    "keyCharacteristics": [
      "One accent, teal; red only for errors, amber only near a limit.",
      "Atkinson Hyperlegible Next for reading, its Mono only for data.",
      "Ruled lists and one sheet per view; depth in three layers.",
      "Every shortcut printed as a key cap that presses when used.",
      "Motion is exponential ease-out, has a job, and never holds input."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Teal is the only accent. Red and amber are signals, not decoration.",
        "section": "colors"
      },
      {
        "name": "The Coloured Text Rule",
        "body": "Text on a coloured surface uses that surface's own ink token, never a grey.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "Monospace is for things that are measured or identified: counts, limits, widths, IDs, keys.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use tokens from apps/web/src/styles/tokens.css for every value.",
      "Do keep the composer one sheet with ruled lists.",
      "Do print a key cap for every shortcut and give the control aria-keyshortcuts.",
      "Do show counts on focus or past 90% of a limit.",
      "Do give every data view loading, empty and error states.",
      "Do keep the preview in Discord's exact colours and metrics."
    ],
    "donts": [
      "Don't box sections or rows inside the sheet.",
      "Don't add a second accent colour, gradients, glass or glow.",
      "Don't use monospace for labels or headings.",
      "Don't use View Transitions or delays for navigation.",
      "Don't bind browser-reserved shortcuts such as Alt+number.",
      "Don't use Discord's logo, font or chrome outside the preview."
    ]
  }
}