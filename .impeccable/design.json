      "css": ".ds-ctl{display:grid;gap:var(--space-2);font-family:var(--font-sans)}.ds-top{display:flex;justify-content:space-between;font-size:var(--text-label);font-weight:650}.ds-count{font-family:var(--font-mono);font-size:var(--text-meta);color:var(--ink-2);opacity:0;transition:opacity var(--dur-base)}.ds-ctl:focus-within .ds-count{opacity:1}.ds-ctl input{min-height:var(--tap);padding:var(--space-2) var(--space-3);border:1px solid var(--field-line);border-radius:var(--radius-md);background:var(--field);color:var(--ink);font:inherit}.ds-ctl input:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 1px var(--ring),0 0 0 4px var(--accent-wash-2)}"
    },
