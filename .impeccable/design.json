      "html": "<nav class=\"ds-seg\"><a class=\"ds-on\" href=\"#\">Compose</a><a href=\"#\">Send</a></nav>",
      "css": ".ds-seg{display:inline-grid;grid-auto-flow:column;padding:var(--space-hair);background:var(--ground);border:1px solid var(--rule-2);border-radius:var(--radius-lg)}.ds-seg a{min-height:var(--tap);display:inline-flex;align-items:center;padding:0 var(--space-4);border-radius:var(--radius-md);color:var(--ink-2);font-weight:650;text-decoration:none}.ds-seg a:hover{color:var(--ink)}.ds-seg a.ds-on{background:var(--sheet);color:var(--ink);box-shadow:var(--shadow-1),0 0 0 1px var(--rule-2)}"
