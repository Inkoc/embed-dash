      "css": ".ds-budget{display:grid;grid-template-columns:auto auto;gap:var(--space-2) var(--space-3);font-size:var(--text-meta);color:var(--ink-2)}.ds-num{font-family:var(--font-mono)}.ds-num b{color:var(--ink)}.ds-ruler{grid-column:1/-1;position:relative;width:11rem;height:.5rem;border-bottom:1px solid var(--field-line);background:linear-gradient(to right,var(--field-line) 1px,transparent 1px) left bottom/calc(100%/6) 100% repeat-x;overflow:hidden}.ds-ruler span{position:absolute;left:0;bottom:0;height:3px;width:7.25%;background:var(--accent)}"
