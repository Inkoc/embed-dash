      "css": ".ds-key{display:inline-flex;font-family:var(--font-mono);font-size:var(--text-key);font-weight:600;line-height:1;padding:.25em .45em .2em;border:1px solid var(--rule-2);box-shadow:inset 0 -1px 0 var(--rule-2);border-radius:var(--radius-xs);color:var(--ink-2);background:var(--sheet);transition:transform var(--dur-fast) var(--ease-out)}.ds-pressed{transform:translateY(1px);box-shadow:none;border-color:var(--accent);color:var(--accent);background:var(--accent-wash)}"
