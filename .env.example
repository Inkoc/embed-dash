# Server configuration. Secret files take precedence over direct values.
# Relative paths use INIT_CWD (pnpm invoking directory), otherwise the process cwd.
BOT_TOKEN_FILE=./secrets/bot_token.txt
# BOT_TOKEN= (alternative to BOT_TOKEN_FILE; never commit a token)
PORT=8742
# Loopback outside Docker; the container sets 0.0.0.0.
HOST=127.0.0.1
DATA_DIR=./data
DISCORD_API_BASE=https://discord.com/api
# Set by the container; enables serving the built SPA.
NODE_ENV=production
# Optional coverage output directory for local checks.
# COVERAGE_DIR=./coverage
# PLAYWRIGHT_OUTPUT_DIR=./test-results

# Password login is the default. none is for loopback-only local setups.
AUTH_MODE=password
ADMIN_PASSWORD_FILE=./secrets/admin_password.txt
# ADMIN_PASSWORD= (alternative; secret file takes precedence)
# E2E_PORT=28742 (override to avoid concurrent test servers)
# E2E_AUTH_MODE=none (default exercises password login)

# Proxy trust is off by default. Use only the actual proxy connection IPs.
TRUST_PROXY=off
# TRUST_PROXY=127.0.0.1,::1
# PUBLIC_URL=https://embed.example (optional expected origin, without a path)
# Compose local mode without a password file:
# AUTH_MODE=none ADMIN_PASSWORD_SECRET_FILE=/dev/null docker compose up --build
