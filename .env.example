# Server configuration. Secret files take precedence over direct values.
# Relative paths use INIT_CWD (pnpm invoking directory), otherwise the process cwd.
BOT_TOKEN_FILE=./secrets/bot_token.txt
# BOT_TOKEN= (alternative to BOT_TOKEN_FILE; never commit a token)
PORT=8742
# Loopback outside Docker; the container sets 0.0.0.0.
HOST=127.0.0.1
DATA_DIR=./data
DISCORD_API_BASE=https://discord.com/api
# Set by the container; enables serving the built SPA.
NODE_ENV=production
# Optional coverage output directory for local checks.
# COVERAGE_DIR=./coverage
# PLAYWRIGHT_OUTPUT_DIR=./test-results
